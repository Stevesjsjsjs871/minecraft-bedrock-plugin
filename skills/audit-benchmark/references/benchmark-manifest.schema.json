{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minecraft Bedrock Engineer real-pack benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "target_game_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "target_game_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "notes": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "path",
        "evidence_note"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_severity": {
          "enum": [
            "BLOCKER",
            "HIGH",
            "MEDIUM",
            "LOW",
            "INFO"
          ]
        },
        "evidence_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "source_name",
        "source_url",
        "retrieved_on",
        "artifact_sha256",
        "license_status",
        "label_status",
        "target_game_version",
        "pack_types",
        "runtime_verification",
        "scored_rules",
        "expected_findings",
        "review_notes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "license_status": {
          "enum": [
            "redistributable",
            "permission_granted",
            "local_only",
            "unknown"
          ]
        },
        "label_status": {
          "enum": [
            "reviewed",
            "pending"
          ]
        },
        "target_game_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "pack_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BP",
              "RP",
              "WORLD",
              "ADDON"
            ]
          }
        },
        "runtime_verification": {
          "enum": [
            "NOT_RUN",
            "PARTIAL",
            "TESTED"
          ]
        },
        "scored_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "review_notes": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_count": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.(?:mcaddon|mcpack|mcworld|zip)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label_status": {
                "const": "reviewed"
              }
            },
            "required": [
              "label_status"
            ]
          },
          "then": {
            "properties": {
              "scored_rules": {
                "minItems": 1
              }
            },
            "required": [
              "artifact_filename"
            ]
          }
        }
      ]
    }
  }
}
