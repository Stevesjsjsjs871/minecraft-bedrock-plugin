{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minecraft Bedrock Change Impact Report",
  "description": "Static, bounded dependency graph and reverse-impact report. Edges run from a consumer to the resource it depends on.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_root_name", "changed_paths", "impact", "summary", "coverage", "edges", "findings", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_root_name": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "impact": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "depth", "via", "impact", "confidence"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "depth": {"type": "integer", "minimum": 0},
          "via": {"type": "array", "items": {"type": "string"}},
          "impact": {"enum": ["DIRECT", "INDIRECT"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "relationship": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "direct_changes", "affected_files", "graph_edges", "declared_identifiers", "parsed_json_files", "parsed_script_files", "parse_failures", "high_severity_findings", "ambiguous_references", "unresolved_references", "changed_dependency_misses", "changed_paths_present"],
      "properties": {
        "status": {"enum": ["PASS", "PARTIAL"]},
        "direct_changes": {"type": "integer", "minimum": 1},
        "affected_files": {"type": "integer", "minimum": 0},
        "graph_edges": {"type": "integer", "minimum": 0},
        "declared_identifiers": {"type": "integer", "minimum": 0},
        "parsed_json_files": {"type": "integer", "minimum": 0},
        "parsed_script_files": {"type": "integer", "minimum": 0},
        "parse_failures": {"type": "integer", "minimum": 0},
        "high_severity_findings": {"type": "integer", "minimum": 0},
        "ambiguous_references": {"type": "integer", "minimum": 0},
        "unresolved_references": {"type": "integer", "minimum": 0},
        "changed_dependency_misses": {"type": "integer", "minimum": 0},
        "changed_paths_present": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanned_files", "scanned_bytes", "truncated", "symlinks_skipped", "files_exceeding_total_byte_budget", "unreadable_entries", "parse_skipped_size", "ignored_directories"],
      "properties": {
        "scanned_files": {"type": "integer", "minimum": 0},
        "scanned_bytes": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "symlinks_skipped": {"type": "integer", "minimum": 0},
        "files_exceeding_total_byte_budget": {"type": "integer", "minimum": 0},
        "unreadable_entries": {"type": "integer", "minimum": 0},
        "parse_skipped_size": {"type": "integer", "minimum": 0},
        "ignored_directories": {"type": "array", "items": {"type": "string"}}
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind", "reference", "confidence"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"type": "string"},
          "reference": {"type": "string"},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "object", "required": ["code", "severity", "confidence", "message"], "properties": {"code": {"type": "string"}, "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"]}, "confidence": {"enum": ["CONFIRMED", "HIGH", "MEDIUM", "LOW" ]}, "message": {"type": "string"}, "path": {"type": "string"}, "reference": {"type": "string"}, "owners": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
