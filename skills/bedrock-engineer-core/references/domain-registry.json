  "capability_routes": [
    {
      "id": "conversation_files",
      "meaning": "Files attached to the current conversation and actually accessible in the runtime."
    },
    {
      "id": "connected_workspace",
      "meaning": "A connected file/workspace tool explicitly exposed and authorized for this task."
    },
    {
      "id": "local_executor",
      "meaning": "A real Python/terminal executor with the package/project files mounted."
    },
    {
      "id": "creator_tools_cli",
      "meaning": "An installed local Creator Tools CLI explicitly authorized by the user, after checking its version and help."
    },
    {
      "id": "no_execution_route",
      "meaning": "No usable file/edit/execute capability; return an unapplied patch or exact instructions and mark work NOT APPLIED/NOT RUN."
    }
  ],
  "status_vocabulary": [
    "PASS",
    "FAIL",
    "BLOCKED",
    "NOT RUN",
    "NOT APPLIED",
    "CONFIRMED_IN_SOURCE",
    "STATICALLY VERIFIED",
    "RUNTIME TESTED",
