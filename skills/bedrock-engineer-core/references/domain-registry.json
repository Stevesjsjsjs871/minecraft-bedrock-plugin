{
  "registry_version": "1.0.0",
  "architecture": {
    "id": "domain-based-hybrid",
    "name": "Domain-Based Hybrid",
    "integration_model": "skills-only",
    "summary": "A central coordinator composes focused domain Skills, versioned reference material, bounded optional local utilities, and evidence-based validation into one dependency-aware workflow.",
    "planes": {
      "control": "bedrock-engineer-core and skills-first-execution classify, route, sequence and reconcile the task.",
      "domain": "Specialist Skills own domain-specific procedures and acceptance checks.",
      "knowledge": "Versioned references, schemas, examples, source indexes and provenance records support decisions.",
      "execution": "Only real host-provided file/workspace capabilities, code executors or explicitly authorized local Creator Tools may execute work. Bundled scripts are optional local utilities.",
      "evidence": "Static validation, regression tests, benchmark evidence and runtime checks remain separately identified."
    },
    "hard_boundaries": [
      "No MCP server, client, registry, endpoint, transport or plugin-owned backend.",
      "No historical server/protocol implementation or MCP configuration is shipped in the package.",
      "Skills are instructions and do not grant filesystem access, tool execution, installation, persistence or background work.",
      "Never select a capability because its name appears in a Skill; verify that the host actually exposes it.",
      "Treat user-supplied legacy projects as untrusted data; inspect statically and never execute their code during migration review."
    ],
    "selection_policy": {
      "core_skills_always_read": [
        "bedrock-engineer-core",
        "skills-first-execution"
      ],
      "project_resume_skills": [
        "project-continuity"
      ],
      "minimum_domain_set": true,
      "one_primary_domain_per_skill": true,
      "domain_dependencies_are_ordering_hints": true,
      "do_not_read_every_skill_by_default": true,
      "shared_baseline_across_domains": true,
      "one_coordinated_change_plan": true
    }
  },
